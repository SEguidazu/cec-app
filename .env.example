# PlusPagos Configuration - Click de Pago (Tecnología Macro)

# Secret Key del comercio proporcionada por Click de Pago
VITE_PLUSPAGOS_SECRET_KEY=your-secret-key-here

# Identificador único del comercio en Click de Pago
VITE_PLUSPAGOS_COMERCIO=your-commerce-id-here

# URL de redirección tras transacción finalizada exitosamente (Encriptado: SÍ)
VITE_PLUSPAGOS_CALLBACK_SUCCESS=http://localhost:5173/pago/success

# URL de redirección en caso de que el usuario cancele el pago (Encriptado: SÍ)
VITE_PLUSPAGOS_CALLBACK_CANCEL=http://localhost:5173/pago/cancel

# URL de redirección para la creación de un DEBIN correcto (Encriptado: SÍ)
VITE_PLUSPAGOS_CALLBACK_PENDING=http://localhost:5173/pago/pending

# URL del gateway de Click de Pago para el POST
VITE_PLUSPAGOS_GATEWAY_URL=https://sandbox.clickdepago.com.ar/api/v1/pago
